@startuml Sunrise-Dental-Clinic-Design-Class
' =====================================================================
'  CIS6003 Advanced Programming - WRIT1
'  Sunrise Dental Clinic Appointment & Patient Management System
'  Task B - Design / Architecture Class Diagram
'           Shows the three physical tiers and the design patterns
'           applied in each.          Author: <your name / student ID>
' =====================================================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 4
skinparam ArrowColor #0E2B2E
skinparam ArrowFontSize 11
skinparam nodesep 28
skinparam ranksep 50
skinparam DefaultFontName "Segoe UI"
skinparam packageStyle rectangle

skinparam class {
  BorderColor #0E2B2E
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #E9F0EE
  FontSize 12
  AttributeFontSize 11
}
skinparam package {
  BorderColor #0C7B72
  FontColor #0C7B72
  FontSize 13
  FontStyle bold
}

' =====================================================================
'  TIER 1 - PRESENTATION
'
'  TWO independent clients over one API. Neither holds a business rule, so
'  a second client could be added without duplicating any logic - which is
'  the practical proof that the tiers are genuinely separated.
' =====================================================================

package "TIER 1a - browser client  [HTML / CSS / JS]" as T1A {

  class "index.html" as HTML <<view>> {
    Login, Book, Search, Billing,
    Reports and Help sections
    ..
    Sections are shown and hidden by
    showPanel(); no page reloads.
  }

  class "app.css" as CSS <<style>> {
    Design tokens, responsive grid
    @media print - strips navigation
    so only the receipt is printed
  }

  class Session <<Singleton>> {
    + save(dto) : void
    + token() : String
    + role() : String
    + isLive() : boolean
    + can(...roles) : boolean
    ..
    Token held in sessionStorage, not a
    cookie: attached deliberately, so
    CSRF does not apply. Cleared when
    the tab closes.
  }

  class "request()" as FETCH <<Proxy>> {
    + request(method, path, body) : JSON
    - attaches Authorization header
    - maps 401 to sign-in, 409 to slots
  }

  class api <<facade>> {
    + login() + book() + appointment()
    + generateBill() + report() ...
  }

  class ApiError {
    + status : int
    + suggestedSlots : String[]
  }
}

package "TIER 1b - desktop client  [Java Swing]" as T1B {

  class MainMenuFrame <<boundary>> {
    - session : Session
    + showFor(role : Role) : void
  }
  class LoginFrame <<boundary>>
  class BookAppointmentFrame <<boundary>>
  class SearchAppointmentFrame <<boundary>>
  class BillingFrame <<boundary>>
  class ReportFrame <<boundary>>
  class HelpFrame <<boundary>>

  class RestClient {
    - baseUrl : String
    - httpClient : HttpClient
    + get(path : String, type : Class<T>) : T
    + post(path : String, body : Object, type : Class<T>) : T
    - attachBearerToken(req : HttpRequest.Builder) : void
  }

  class AuthServiceProxy <<Proxy>> {
    + login(username : String, password : String) : SessionDTO
    + logout() : void
  }
  class ClinicServiceProxy <<Proxy>> {
    + book(dto : BookingRequestDTO) : AppointmentDTO
    + findByNumber(no : String) : AppointmentDTO
    + generateBill(appointmentNo : String) : BillDTO
  }

  class SessionHolder <<Singleton>> {
    - {static} instance : SessionHolder
    - token : String
    - expiresAt : LocalDateTime
    + {static} getInstance() : SessionHolder
    + isExpired() : boolean
  }
}

' =====================================================================
'  TIER 2 - BUSINESS   (Spring Boot REST service, separate process)
' =====================================================================
package "TIER 2 - api  [REST controllers]" as T2A {
  class AuthController <<control>> {
    + login(req : LoginRequest) : ResponseEntity<SessionDTO>
  }
  class AppointmentController <<control>> {
    + book(req : BookingRequestDTO) : ResponseEntity<AppointmentDTO>
    + findByNumber(no : String) : ResponseEntity<AppointmentDTO>
    + cancel(no : String) : ResponseEntity<Void>
  }
  class BillingController <<control>>
  class ReportController <<control>>

  class AppointmentMapper <<Adapter>> {
    + toDTO(entity : Appointment) : AppointmentDTO
    + toEntity(dto : BookingRequestDTO) : Appointment
  }
}

package "TIER 2 - service  [business logic]" as T2B {
  class AuthenticationService
  class AppointmentService {
    + book(request : BookingRequest) : Appointment
    - assertNoClash(d : Dentist, from : LocalTime, to : LocalTime) : void
  }
  class BillingFacade <<Facade>> {
    + generateBill(appointmentNo : String) : Bill
  }
  class ReportService
}

package "TIER 2 - pattern  [GoF participants]" as T2C {
  interface DiscountStrategy <<Strategy>> {
    + {abstract} calculate(subtotal : BigDecimal) : BigDecimal
  }
  class SeniorCitizenDiscount
  class LoyaltyDiscount
  class StaffDiscount
  class NoDiscount

  interface AppointmentObserver <<Observer>> {
    + {abstract} onAppointmentCreated(a : Appointment) : void
  }
  class NotificationObserver
  class AuditLogObserver

  abstract class AbstractReport <<Template Method>> {
    + {final} generate() : Report
    # {abstract} buildBody() : Section
  }
  class DailyRevenueReport
  class DentistUtilisationReport
  class ReportFactory <<Factory Method>> {
    + {static} create(type : ReportType) : AbstractReport
  }
}

package "TIER 2 - repository  [DAO]" as T2D {
  interface AppointmentRepository <<Repository>> {
    + save(a : Appointment) : Appointment
    + findByAppointmentNo(no : String) : Optional<Appointment>
    + findClashes(dentistId : Long, d : LocalDate, from : LocalTime, to : LocalTime) : List<Appointment>
  }
  interface PatientRepository <<Repository>>
  interface BillRepository <<Repository>>
}

' =====================================================================
'  TIER 3 - DATA   (MySQL server, separate process)
' =====================================================================
package "TIER 3 - MySQL  [data]" as T3 {
  class "«table» appointment" as TBL_APP
  class "«table» patient"     as TBL_PAT
  class "«table» bill"        as TBL_BILL
  class "«trigger» trg_appointment_no_overlap" as TRG {
    Rejects an INSERT or UPDATE whose
    time range overlaps an existing
    BOOKED appointment for the same dentist.
  }
  class "«function» fn_treatment_subtotal" as FN {
    Returns the summed price of every
    treatment on an appointment.
  }
  class "«procedure» sp_generate_bill" as SP {
    In one transaction: adds the dentist
    consultation fee, subtracts the supplied
    discount, writes bill + bill lines.
  }
}

' ---------------------------------------------------------------------
'  RELATIONSHIPS
' ---------------------------------------------------------------------

' ---- TIER 1a browser ------------------------------------------------
HTML  ..> CSS   : styled by >
HTML  ..> api   : calls >
api   --|> FETCH
FETCH ..> Session   : reads token >
FETCH ..> ApiError  : throws >

' ---- TIER 1b desktop -------------------------------------------------
LoginFrame              ..> AuthServiceProxy
MainMenuFrame           ..> SessionHolder
BookAppointmentFrame    ..> ClinicServiceProxy
SearchAppointmentFrame  ..> ClinicServiceProxy
BillingFrame            ..> ClinicServiceProxy
ReportFrame             ..> ClinicServiceProxy
HelpFrame               ..> MainMenuFrame

AuthServiceProxy        --|> RestClient
ClinicServiceProxy      --|> RestClient
RestClient              ..> SessionHolder : reads token >

' ---- THE BOUNDARY: both clients cross HTTP to reach tier 2 -----------
FETCH              ..> AuthController        : <<HTTP / JSON>>
FETCH              ..> AppointmentController : <<HTTP / JSON>>
AuthServiceProxy   ..> AuthController        : <<HTTP / JSON>>
ClinicServiceProxy ..> AppointmentController : <<HTTP / JSON>>
ClinicServiceProxy ..> BillingController     : <<HTTP / JSON>>

AuthController        ..> AuthenticationService
AppointmentController ..> AppointmentService
AppointmentController ..> AppointmentMapper
BillingController     ..> BillingFacade
ReportController      ..> ReportService

AppointmentService "1" o-- "0..*" AppointmentObserver : notifies >
AppointmentService ..> AppointmentRepository
BillingFacade      ..> DiscountStrategy : uses >
BillingFacade      ..> BillRepository
ReportService      ..> ReportFactory
ReportFactory      ..> AbstractReport : creates >

DiscountStrategy <|.. SeniorCitizenDiscount
DiscountStrategy <|.. LoyaltyDiscount
DiscountStrategy <|.. StaffDiscount
DiscountStrategy <|.. NoDiscount
AppointmentObserver <|.. NotificationObserver
AppointmentObserver <|.. AuditLogObserver
AbstractReport <|-- DailyRevenueReport
AbstractReport <|-- DentistUtilisationReport

AppointmentRepository ..> TBL_APP : <<JDBC>>
PatientRepository     ..> TBL_PAT : <<JDBC>>
BillRepository        ..> TBL_BILL : <<JDBC>>
BillRepository        ..> FN       : calls >
BillRepository        ..> SP       : calls >
TBL_APP               ..> TRG      : enforced by >

legend right
  |= Tier |= Process |= Patterns applied |
  | 1a Browser | Chrome, served from :8080 | Singleton (Session), Proxy (request),\n Facade (api), Null-safe rendering |
  | 1b Desktop | Swing client JAR | Proxy, Singleton, MVC |
  | 2 Business | Spring Boot, port 8080 | Facade, Strategy, Observer, Factory Method,\n Template Method, Adapter/DTO, Repository,\n DAO, dependency injection |
  | 3 Data | MySQL, port 3306 | Trigger, stored function and stored procedure\n enforcing business rules at the data tier |
  | | | **Two independent clients share one API.** Neither\n holds a business rule - if any had leaked into a\n client, the second could not exist without\n duplicating it. The HTTP hop is what makes this a\n **distributed** system rather than a layered one. |
endlegend

@enduml
