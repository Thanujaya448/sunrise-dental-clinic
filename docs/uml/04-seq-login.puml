@startuml Seq-01-Login
' =====================================================================
'  CIS6003 Advanced Programming - WRIT1
'  Task A - Sequence Diagram 1 of 3 : UC-01 Log In
'  Covers FR-01, FR-02, FR-03, FR-04, FR-05, FR-24
'
'  Participants and message names are taken from the IMPLEMENTED
'  classes. The Swing client is shown; the browser client follows the
'  identical sequence through request() in app.js, which is the point
'  of putting the rules behind one API.
'  Author: <your name / student ID>
' =====================================================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam DefaultFontName "Segoe UI"
skinparam ArrowColor #0E2B2E
skinparam sequenceMessageAlign first
skinparam maxMessageSize 220

skinparam sequence {
  ParticipantBorderColor #0E2B2E
  ParticipantBackgroundColor #E9F0EE
  ActorBorderColor #0E2B2E
  ActorBackgroundColor #E9F0EE
  LifeLineBorderColor #B4C8C4
  LifeLineBackgroundColor #F5F8F7
  BoxBorderColor #0C7B72
  BoxFontColor #0C7B72
  GroupBorderColor #0C7B72
  GroupHeaderFontColor #0C7B72
  DividerBackgroundColor #E9F0EE
}

actor "Receptionist" as User

box "TIER 1 - Swing client" #FCFEFD
  participant "LoginFrame\n<<boundary>>" as UI
  participant "AuthServiceProxy\n<<Proxy>>" as Proxy
  participant "SessionHolder\n<<Singleton>>" as Holder
end box

box "TIER 2 - Spring Boot REST service" #FCFEFD
  participant "ClinicController\n<<control>>" as Ctrl
  participant "AuthenticationService" as Svc
  participant "ClinicRepository\n<<Repository>>" as Repo
  participant "GlobalExceptionHandler" as Err
end box

database "MySQL" as DB

autonumber "<b>[00]"

User -> UI ++ : enter username and password
UI -> UI : validateNotEmpty()
note right of UI
  Client-side validation only.
  The server re-validates - the client
  is never trusted (NFR-04).
end note

UI -> Proxy ++ : login(username, password)
Proxy -> Ctrl ++ : **POST /api/auth/login**\n{ "username": "...", "password": "..." }
note over Proxy, Ctrl #E0F0ED
  The HTTP boundary. Tier 1 and tier 2 are
  separate operating-system processes - this
  is what makes the system **distributed**
  rather than merely layered (NFR-01).
end note

Ctrl -> Svc ++ : login(username, rawPassword)
Svc -> Repo ++ : findStaffByUsername(username)
Repo -> DB ++ : SELECT staff_id, password_hash, full_name,\nrole, active, failed_attempts, locked\nFROM staff WHERE username = ?
return result row
return Optional<Map<String, Object>>

alt#Gold #FBEDEB account already locked
  note right of Svc #FBEDEB
    FR-03. The lock is checked FIRST, before
    the password is even compared - a locked
    account cannot be probed further.
  end note
  Svc -> Err : AccountLockedException
  Err --> Proxy : **423 Locked**\n{ "message": "This account is locked..." }
  Proxy --> UI : ApiException
  UI -> User : "This account is locked. Please ask\nthe Administrator to unlock it."

else #FDF6EE password does not match
  Svc -> Svc : encoder.matches(rawPassword, passwordHash)
  Svc -> Repo : recordLoginFailure(staffId)
  Repo -> DB : UPDATE staff SET failed_attempts = failed_attempts + 1,\nlocked = (failed_attempts + 1 >= 5)
  note right of Repo #FDF6EE
    FR-03. The counter and the lock are set in
    ONE statement, so two simultaneous attempts
    cannot both read the old count.
  end note
  Svc -> Err : AuthenticationFailedException
  Err --> Proxy : **401 Unauthorized**\n{ "message": "Invalid username or password.\n4 attempts remaining." }
  Proxy --> UI : ApiException
  UI -> User : "Invalid username or password.\n4 attempts remaining."
  note right of UI #FDF6EE
    The message deliberately does not say
    **which** field was wrong. Saying so would
    confirm to an attacker that a username
    exists (NFR-06).
  end note

else #F5FBFA credentials valid and account active
  Svc -> Svc : encoder.matches(rawPassword, passwordHash)
  note right of Svc
    FR-02. BCrypt. The stored value is a
    one-way hash - the plaintext password is
    never persisted and cannot be recovered.
  end note

  Svc -> Repo : resetLoginFailures(staffId)
  Svc -> Svc : sessions.put(UUID token, Session)
  note right of Svc
    FR-04. The token expires after the
    configured idle window (20 minutes),
    read from clinic_setting.
  end note

  Svc -> Repo : writeAudit(username, "LOGIN", ...)
  Repo -> DB : INSERT INTO audit_entry
  note right of Repo
    FR-24. Who signed in, and when, is
    recoverable afterwards.
  end note

  return SessionDTO(token, fullName, role, expiresAt)

  Ctrl --> Proxy -- : **200 OK**\n{ token, fullName, role, expiresAt }
  Proxy -> Holder : store(token, expiresAt)
  return SessionDTO

  UI -> UI : dispose()
  UI -> User -- : MainMenuFrame.showFor(role)
  note left of User
    FR-05. The menu is built from the role - but
    every endpoint still calls requireRole() on
    the server. Hiding a button is not a control.
  end note
end

@enduml
