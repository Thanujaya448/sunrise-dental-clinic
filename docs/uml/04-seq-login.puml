@startuml Seq-01-Login
' =====================================================================
'  CIS6003 Advanced Programming - WRIT1
'  Task A - Sequence Diagram 1 of 3 : UC-01 Log In
'  Covers FR-01, FR-02, FR-03, FR-04, FR-05
'  Author: Thanujaya Hasaranga
' =====================================================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam DefaultFontName "Segoe UI"
skinparam ArrowColor #0E2B2E
skinparam sequenceMessageAlign first
skinparam maxMessageSize 220

skinparam sequence {
  ParticipantBorderColor #0E2B2E
  ParticipantBackgroundColor #E9F0EE
  ActorBorderColor #0E2B2E
  ActorBackgroundColor #E9F0EE
  LifeLineBorderColor #B4C8C4
  LifeLineBackgroundColor #F5F8F7
  BoxBorderColor #0C7B72
  BoxFontColor #0C7B72
  GroupBorderColor #0C7B72
  GroupHeaderFontColor #0C7B72
  DividerBackgroundColor #E9F0EE
}

actor "Receptionist" as User

box "TIER 1 - Swing client" #FCFEFD
  participant "LoginFrame\n<<boundary>>" as UI
  participant "AuthServiceProxy\n<<Proxy>>" as Proxy
  participant "SessionHolder\n<<Singleton>>" as Holder
end box

box "TIER 2 - Spring Boot REST service" #FCFEFD
  participant "AuthController\n<<control>>" as Ctrl
  participant "AuthenticationService" as Svc
  participant "StaffUserRepository\n<<Repository>>" as Repo
end box

database "MySQL" as DB

autonumber "<b>[00]"

User -> UI ++ : enter username and password
UI -> UI : validateNotEmpty()
note right of UI
  Client-side validation only.
  The server re-validates - the client
  is never trusted (NFR-04).
end note

UI -> Proxy ++ : login(username, password)
Proxy -> Ctrl ++ : **POST /api/auth/login**\n{ "username": "...", "password": "..." }
note over Proxy, Ctrl #E0F0ED
  The HTTP boundary. Tier 1 and tier 2 are
  separate operating-system processes - this
  is what makes the system **distributed**
  rather than merely layered (NFR-01).
end note

Ctrl -> Svc ++ : login(username, rawPassword)
Svc -> Repo ++ : findByUsername(username)
Repo -> DB ++ : SELECT staff_id, password_hash,\nrole, active, failed_attempts\nFROM staff WHERE username = ?
return result row
return Optional<StaffUser>

alt#Gold #F5FBFA credentials valid and account active

  Svc -> Svc : BCrypt.matches(rawPassword, passwordHash)
  note right of Svc
    FR-02. The stored value is a one-way
    hash - the plaintext password is never
    persisted and cannot be recovered.
  end note

  Svc -> Repo : resetFailedAttempts(staffId)
  Svc -> Svc : createSession(staffUser)
  note right of Svc
    FR-04. Token with a 20-minute
    idle expiry.
  end note
  return SessionDTO(token, role, expiresAt)

  Ctrl --> Proxy -- : **200 OK**\n{ token, role, expiresAt }
  Proxy -> Holder : store(token, expiresAt)
  return SessionDTO

  UI -> UI : dispose()
  UI -> User -- : MainMenuFrame.showFor(role)
  note left of User
    FR-05. The menu is built from the role,
    so a Receptionist never sees the
    Administration options.
  end note

else #FDF6EE invalid credentials

  Svc -> Repo : incrementFailedAttempts(staffId)
  Svc -> Ctrl : AuthenticationException
  Ctrl --> Proxy : **401 Unauthorized**\n{ "message": "Invalid username or password" }
  Proxy --> UI : AuthenticationException
  UI -> User : "Invalid username or password.\n2 attempts remaining."
  note right of UI #FDF6EE
    The message deliberately does not say
    **which** field was wrong. Saying so would
    confirm to an attacker that a username
    exists (NFR-06).
  end note

else #FBEDEB account locked after 5 failed attempts

  Svc -> Ctrl : AccountLockedException
  Ctrl --> Proxy : **423 Locked**
  Proxy --> UI : AccountLockedException
  UI -> User : "Account locked. Contact the\nAdministrator to unlock it."
  note right of UI #FBEDEB
    FR-03. Rate limiting defends against
    brute-force password guessing.
  end note

end

@enduml
